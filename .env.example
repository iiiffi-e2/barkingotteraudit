# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barking_otter?schema=public"

# Google APIs (PageSpeed Insights v5 & Chrome UX Report v1)
GOOGLE_PAGESPEED_API_KEY=""
GOOGLE_CRUX_API_KEY=""

# AI Interpretation Service (OpenAI-compatible / Anthropic-compatible / Gateway)
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"

# Transactional Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Barking Otter <reports@barkingotter.com>"
NOTIFICATION_RECIPIENTS="team@barkingotter.com"

# Admin Authentication & Security
ADMIN_EMAIL_ALLOWLIST="admin@barkingotter.com,founder@barkingotter.com"
ADMIN_ACCESS_TOKEN=""
AUTH_SECRET="change-me-in-production-to-a-32-char-random-secret"

# Public App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GA4_ID=""

# Controlled Development / Preview Demo Mode (never enabled by default in production)
ALLOW_DEMO_FALLBACK="false"
